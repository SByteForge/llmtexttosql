# Uses Ollama (local, free, no API key) by default. Install from
# https://ollama.com, then run `ollama serve` and `ollama pull mistral`
# (or whichever model you set in src/config.yaml).
#
# Only needed if your Ollama server runs somewhere other than localhost:11434 -
# otherwise leave unset and use src/config.yaml's llm.base_url instead.
OLLAMA_BASE_URL=

# Which database backend to use: "sqlite" (bundled demo DB, zero setup) or "mysql"
DB_TYPE=sqlite

# Only used when DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Only used when DB_TYPE=sqlite (defaults to src/data/demo.db if unset)
SQLITE_PATH=src/data/demo.db
